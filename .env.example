# Токен Duffel (https://app.duffel.com → Developers → Access tokens).
# duffel_test_... = тестовый режим, duffel_live_... = настоящие брони.
DUFFEL_TOKEN=

# Почта для отправки писем (например Gmail: smtp.gmail.com, 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VisaBook <you@example.com>"

PORT=3000
BASE_URL=http://localhost:3000

# Аэропорт вылета для всех клиентов
ORIGIN_AIRPORT=EVN

# Цена услуги и сколько часов даётся на оплату
SERVICE_PRICE=5000 AMD
PAY_HOURS=24

# 1 = при новой заявке открывать Trip.com и страницу заявки в браузере, 0 = не открывать
AUTO_OPEN=1

# Где открывать Trip.com: playwright = окно бота (сам вписывает гостя и читает номер брони), browser = ваш обычный Chrome
OPEN_WITH=playwright
